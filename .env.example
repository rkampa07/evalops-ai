# Copy to .env and adjust. No secrets are required to run EvalOps AI locally.

# SQLAlchemy database URL (SQLite file, relative to the backend/ directory when started from there)
EVALOPS_DATABASE_URL=sqlite:///./data/evalops.db

# Comma-separated list of browser origins allowed by CORS (local Vite dev server only by default)
EVALOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated Host header allow-list (protects the local API from DNS rebinding).
# Add your machine's hostname here only if you deliberately expose the API on your network.
EVALOPS_ALLOWED_HOSTS=localhost,127.0.0.1

# Apply Alembic migrations automatically on API startup
EVALOPS_AUTO_MIGRATE=true

# Authentication defaults to OIDC and protected APIs fail closed until configured.
# For a local-only development session, explicitly set both values below and keep the API
# bound to 127.0.0.1 (the Makefile's backend command does this).
EVALOPS_ENV=development
EVALOPS_AUTH_MODE=oidc
EVALOPS_OIDC_ISSUER=
EVALOPS_OIDC_CLIENT_ID=
EVALOPS_OIDC_CLIENT_SECRET=
EVALOPS_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
EVALOPS_AUTH_FRONTEND_URL=http://127.0.0.1:5173
# Local HTTP only. Production must set this true and serve the app over HTTPS.
EVALOPS_AUTH_COOKIE_SECURE=false
EVALOPS_AUTH_SESSION_TTL_SECONDS=28800
EVALOPS_MAX_DATASETS_PER_WORKSPACE=20
EVALOPS_MAX_TEST_CASES_PER_DATASET=10000
EVALOPS_MAX_PASSAGES_PER_WORKSPACE=25000
EVALOPS_MAX_QUEUED_JOBS_PER_WORKSPACE=20
EVALOPS_MAX_ACTIVE_JOBS_PER_WORKSPACE=1
EVALOPS_MAX_QUEUED_CITATION_ASSESSMENTS_PER_WORKSPACE=10
EVALOPS_API_READ_RPM=300
EVALOPS_API_WRITE_RPM=60
EVALOPS_API_JOB_SUBMISSIONS_RPM=5

# Maximum accepted request body size in bytes (default 10 MiB)
EVALOPS_MAX_BODY_BYTES=10485760

# Frontend: base URL of the API
VITE_API_BASE_URL=http://127.0.0.1:8000
