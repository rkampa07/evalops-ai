# Copy to .env and adjust. No secrets are required to run EvalOps AI locally.

# SQLAlchemy database URL (SQLite file, relative to the backend/ directory when started from there)
EVALOPS_DATABASE_URL=sqlite:///./data/evalops.db

# Comma-separated list of browser origins allowed by CORS (local Vite dev server only by default)
EVALOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated Host header allow-list (protects the local API from DNS rebinding).
# Add your machine's hostname here only if you deliberately expose the API on your network.
EVALOPS_ALLOWED_HOSTS=localhost,127.0.0.1

# Apply Alembic migrations automatically on API startup
EVALOPS_AUTO_MIGRATE=true

# Maximum accepted request body size in bytes (default 10 MiB)
EVALOPS_MAX_BODY_BYTES=10485760

# Frontend: base URL of the API
VITE_API_BASE_URL=http://127.0.0.1:8000
